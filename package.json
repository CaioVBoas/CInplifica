{
  "name": "cinplifica",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "./scripts/setup-dev.sh",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
